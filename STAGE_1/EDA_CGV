    "## 6.4. Phát hiện ngoại lệ bằng IQR\n",
    "\n",
    "Quy tắc:\n",
    "\n",
    "- Q1 = phân vị 25%\n",
    "- Q3 = phân vị 75%\n",
    "- IQR = Q3 − Q1\n",
    "- Lower Bound = Q1 − 1.5 × IQR\n",
    "- Upper Bound = Q3 + 1.5 × IQR\n"
   ]
